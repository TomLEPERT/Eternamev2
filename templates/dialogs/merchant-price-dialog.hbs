<form class="merchant-price-dialog">
  <div class="form-group form-group-stacked">
    <label>{{localize 'ETERN.MERCHANT.DIALOG.ITEM'}}</label>
    <input type="text" value="{{itemName}}" disabled>
  </div>
  <div class="merchant-money-grid">
    {{#each priceRows as |row|}}
      <div class="form-group">
        <label>{{row.label}}</label>
        <input type="number" name="price.{{row.key}}" value="{{row.value}}" min="0" step="1">
      </div>
    {{/each}}
  </div>
</form>
