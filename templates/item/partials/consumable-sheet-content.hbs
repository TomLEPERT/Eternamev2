<header class="sheet-header item-sheet-header-card">
  <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="72" width="72"/>
  <div class="header-fields item-header-fields">
    <div class="item-title-row">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'ETERN.CONSUMABLE.NAME'}}"/></h1>
    </div>
    {{#if sheetHeader.badges.length}}
      <div class="sheet-badge-row">
        {{#each sheetHeader.badges as |badge|}}
          <span class="sheet-badge">{{badge}}</span>
        {{/each}}
      </div>
    {{/if}}
    {{#if sheetHeader.statBadges.length}}
      <div class="sheet-stat-row">
        {{#each sheetHeader.statBadges as |badge|}}
          <div class="sheet-stat-pill"><span>{{badge.label}}</span><strong>{{badge.value}}</strong></div>
        {{/each}}
      </div>
    {{/if}}
    <div class="sheet-fields-grid sheet-fields-grid--three">
      <div class="form-group">
        <label>{{localize 'ETERN.CONSUMABLE.CATEGORY.LABEL'}}</label>
        <select name="system.category">
          {{#each consumableCategories}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize 'ETERN.ITEM.LEGALITY.LABEL'}}</label>
        <select name="system.legality">
          {{#each legalityChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize 'ETERN.CONSUMABLE.WEIGHT'}}</label>
        <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs item-sheet-tabs" data-group="primary">
  <a class="item" data-tab="general">{{localize 'ETERN.CONSUMABLE.TABS.GENERAL'}}</a>
  <a class="item" data-tab="description">{{localize 'ETERN.CONSUMABLE.TABS.DESCRIPTION'}}</a>
  {{#if isEnchantableItem}}<a class="item" data-tab="enchantment">{{localize 'ETERN.WEAPON.TABS.ENCHANTMENT'}}</a>{{/if}}
</nav>

<section class="sheet-body">
  <section class="tab" data-group="primary" data-tab="general">
    <section class="sheet-card">
      <div class="sheet-card-head">
        <h3>
          {{#if isConcoctionConsumable}}
            {{localize 'ETERN.CONSUMABLE.CONCOCTION.TYPE'}}
          {{else if isEnchantmentCatalyst}}
            {{localize 'ETERN.CONSUMABLE.CATEGORY.ENCHANTMENT_CATALYST'}}
          {{else}}
            {{localize 'ETERN.CONSUMABLE.CATEGORY.MISC'}}
          {{/if}}
        </h3>
      </div>

      {{#if isConcoctionConsumable}}
        <div class="sheet-fields-grid sheet-fields-grid--two">
          <div class="form-group">
            <label>{{localize 'ETERN.CONSUMABLE.CONCOCTION.TYPE'}}</label>
            <select name="system.concoctionType">
              {{#each concoctionTypeChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      {{/if}}

      {{#if isEnchantmentCatalyst}}
        <div class="sheet-fields-grid sheet-fields-grid--two">
          <div class="form-group">
            <label>{{localize 'ETERN.CONSUMABLE.CATALYST.BASE'}}</label>
            <select name="system.catalystBase">
              {{#each catalystBaseChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>{{localize 'ETERN.CONSUMABLE.CATALYST.ESSENCE_QUALITY.LABEL'}}</label>
            <select name="system.essenceQuality">
              {{#each essenceQualityChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group form-group-stacked sheet-fields-grid--full">
            <label>{{localize 'ETERN.CONSUMABLE.CATALYST.EFFECT'}}</label>
            <textarea rows="5" disabled>{{catalystDefinition.description}}</textarea>
          </div>
        </div>
      {{/if}}

      {{#if isMiscConsumable}}
        <p class="sheet-muted-copy">{{localize 'ETERN.CONSUMABLE.NO_TYPE_FOR_CATEGORY'}}</p>
      {{/if}}
    </section>
  </section>

  <section class="tab" data-group="primary" data-tab="description">
    <section class="sheet-card sheet-card-spacious">
      <div class="sheet-card-head"><h3>{{localize 'ETERN.CONSUMABLE.DESCRIPTION'}}</h3></div>
      <div class="form-group form-group-stacked">
        <textarea name="system.description" rows="12">{{system.description}}</textarea>
      </div>
    </section>
  </section>

  {{#if isEnchantableItem}}
  <section class="tab" data-group="primary" data-tab="enchantment">
    {{> "systems/eternamev2/templates/item/partials/enchantment-panel.hbs"}}
  </section>
  {{/if}}
</section>
