<header class="sheet-header item-sheet-header-card">
  <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="72" width="72"/>
  <div class="header-fields item-header-fields">
    <div class="item-title-row">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'ETERN.BAG.NAME'}}"/></h1>
    </div>
    {{#if sheetHeader.badges.length}}
      <div class="sheet-badge-row">
        {{#each sheetHeader.badges as |badge|}}
          <span class="sheet-badge">{{badge}}</span>
        {{/each}}
      </div>
    {{/if}}
    {{#if sheetHeader.statBadges.length}}
      <div class="sheet-stat-row">
        {{#each sheetHeader.statBadges as |badge|}}
          <div class="sheet-stat-pill"><span>{{badge.label}}</span><strong>{{badge.value}}</strong></div>
        {{/each}}
      </div>
    {{/if}}
    <div class="sheet-fields-grid sheet-fields-grid--three">
      <div class="form-group">
        <label>{{localize 'ETERN.BAG.WEIGHT'}}</label>
        <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/>
      </div>
      <div class="form-group">
        <label>{{localize 'ETERN.BAG.CAPACITY_WEIGHT'}}</label>
        <input type="number" name="system.capacityWeight" value="{{system.capacityWeight}}" min="0" step="0.1"/>
      </div>
      <div class="form-group">
        <label>{{localize 'ETERN.ITEM.LEGALITY.LABEL'}}</label>
        <select name="system.legality">
          {{#each legalityChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs item-sheet-tabs" data-group="primary">
  <a class="item" data-tab="general">{{localize 'ETERN.BAG.TABS.GENERAL'}}</a>
  <a class="item" data-tab="description">{{localize 'ETERN.BAG.TABS.DESCRIPTION'}}</a>
</nav>

<section class="sheet-body">
  <section class="tab" data-group="primary" data-tab="general">
    <section class="sheet-card">
      <div class="sheet-card-head"><h3>{{localize 'ETERN.BAG.CONTENT_TITLE'}}</h3></div>
      <p class="sheet-muted-copy">{{localize 'ETERN.BAG.CONTENT_HELP'}}</p>
      <div class="sheet-fields-grid sheet-fields-grid--two">
        <div class="form-group">
          <label>{{localize 'ETERN.BAG.STORED_WEIGHT'}}</label>
          <input type="text" value="{{bagLoad.currentLabel}} / {{bagLoad.capacityLabel}}" disabled/>
        </div>
        <div class="form-group">
          <label>{{localize 'ETERN.BAG.STATUS'}}</label>
          <input type="text" value="{{#if bagLoad.isOverCapacity}}{{localize 'ETERN.BAG.OVER_CAPACITY'}}{{else}}{{localize 'ETERN.BAG.WITHIN_CAPACITY'}}{{/if}}" disabled/>
        </div>
      </div>
    </section>

    <section class="sheet-card">
      <div class="sheet-card-head"><h3>{{localize 'ETERN.BAG.STORED_ITEMS'}}</h3></div>
      <div class="inv-list">
        <div class="inv-row inv-row-head">
          <div class="inv-name">{{localize 'ETERN.INVENTORY.COLUMNS.NAME'}}</div>
          <div class="inv-qty">{{localize 'ETERN.INVENTORY.COLUMNS.QUANTITY'}}</div>
          <div class="inv-weight">{{localize 'ETERN.INVENTORY.COLUMNS.WEIGHT'}}</div>
          <div class="inv-actions"></div>
        </div>
        {{#each bagStoredItems as |storedItem|}}
          <div class="inv-row">
            <div class="inv-name">{{storedItem.name}}{{#if storedItem.typeLabel}} · {{storedItem.typeLabel}}{{/if}}</div>
            <div class="inv-qty">{{storedItem.quantity}}</div>
            <div class="inv-weight">{{storedItem.totalWeightLabel}}</div>
            <div class="inv-actions">
              <button type="button" data-action="bag-remove-item" data-item-id="{{storedItem.id}}">{{localize 'ETERN.BAG.REMOVE_FROM_BAG'}}</button>
            </div>
          </div>
        {{else}}
          <div class="inv-empty">{{localize 'ETERN.BAG.NO_STORED_ITEMS'}}</div>
        {{/each}}
      </div>
    </section>

    <section class="sheet-card">
      <div class="sheet-card-head"><h3>{{localize 'ETERN.BAG.AVAILABLE_ITEMS'}}</h3></div>
      <div class="inv-list">
        <div class="inv-row inv-row-head">
          <div class="inv-name">{{localize 'ETERN.INVENTORY.COLUMNS.NAME'}}</div>
          <div class="inv-qty">{{localize 'ETERN.INVENTORY.COLUMNS.QUANTITY'}}</div>
          <div class="inv-weight">{{localize 'ETERN.INVENTORY.COLUMNS.WEIGHT'}}</div>
          <div class="inv-actions"></div>
        </div>
        {{#each bagAvailableItems as |availableItem|}}
          <div class="inv-row">
            <div class="inv-name">{{availableItem.name}}{{#if availableItem.typeLabel}} · {{availableItem.typeLabel}}{{/if}}</div>
            <div class="inv-qty">{{availableItem.quantity}}</div>
            <div class="inv-weight">{{availableItem.weightLabel}}</div>
            <div class="inv-actions">
              <button type="button" data-action="bag-store-item" data-item-id="{{availableItem.id}}">{{localize 'ETERN.BAG.STORE_IN_BAG'}}</button>
            </div>
          </div>
        {{else}}
          <div class="inv-empty">{{localize 'ETERN.BAG.NO_AVAILABLE_ITEMS'}}</div>
        {{/each}}
      </div>
    </section>
  </section>

  <section class="tab" data-group="primary" data-tab="description">
    <section class="sheet-card sheet-card-spacious">
      <div class="sheet-card-head"><h3>{{localize 'ETERN.BAG.DESCRIPTION'}}</h3></div>
      <div class="form-group form-group-stacked">
        <textarea name="system.description" rows="12">{{system.description}}</textarea>
      </div>
    </section>
  </section>
</section>
